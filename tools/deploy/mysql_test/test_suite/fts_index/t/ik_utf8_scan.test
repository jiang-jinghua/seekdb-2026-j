SELECT TOKENIZE(CONVERT(X'e4b880414243313233e9bfbfefbca1efbc91' USING utf8mb4), 'ik', '[{"output":"all"}]') AS tokens;
SELECT TOKENIZE(CONVERT(X'f0908080e4b880f0a08080e9bfbff48fbfbf' USING utf8mb4), 'ik', '[{"output":"all"}]') AS tokens;
SELECT TOKENIZE(CONVERT(X'e4b7bfe4b880e4b881e9bfbee9bfbfea8080' USING utf8mb4), 'ik', '[{"output":"all"},{"additional_args":[{"ik_mode":"max_word"}]}]') AS tokens;
SELECT TOKENIZE(CONVERT(X'00417a3039207f' USING utf8mb4) COLLATE utf8mb4_bin, 'ik', '[{"output":"all"}]') AS tokens;

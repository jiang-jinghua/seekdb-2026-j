SET NAMES utf8mb4;
SELECT TOKENIZE(CONVERT(X'00417a3039207f' USING utf8mb4), 'ik', '[{"output":"all"}]') AS tokens;
SELECT TOKENIZE(CONVERT(X'e4b7bfe4b880e4b881e9bfbee9bfbfea8080' USING utf8mb4), 'ik', '[{"output":"all"}]') AS tokens;

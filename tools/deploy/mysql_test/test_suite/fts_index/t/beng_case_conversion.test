SET NAMES utf8mb4;
SELECT HEX(LOWER(CONVERT(X'00417f5a2061c389c3a9c4b0cea3cf83e4b8adf0a08080' USING utf8mb4))) AS bytes;
SELECT LOWER('AZaz café CAFÉ İ I i Σ σ ς 中文') AS lower_text;
SELECT TOKENIZE('ALPHA beta GAMMA delta epsilon zeta eta theta iota kappa ALPHA beta', 'beng', '[{"output":"all"}]') AS tokens;
SELECT TOKENIZE(CONCAT(REPEAT('ALPHA beta gamma ',40),'omega'), 'beng', '[{"output":"all"}]') AS tokens;
SELECT TOKENIZE(CONCAT('short ',REPEAT('abcdefgh',9),' tiny ',REPEAT('Z',84),' endword short ',REPEAT('Q',85)), 'beng', '[{"output":"all"}]') AS tokens;
SELECT TOKENIZE('...ALPHA!!! beta,gamma? /delta/ epsilon_ café Σ 中文', 'beng', '[{"output":"all"}]') AS tokens;
--disable_warnings
DROP TABLE IF EXISTS beng_case_conversion;
--enable_warnings
CREATE TABLE beng_case_conversion(id INT PRIMARY KEY,title VARCHAR(200),body TEXT);
INSERT INTO beng_case_conversion VALUES (1,'ALPHA beta',CONCAT(REPEAT('gamma delta ',20),'omega')),(2,'epsilon zeta','theta iota'),(3,'OMEGA sigma','alpha tau'),(4,'kappa lambda','short tiny');
ALTER TABLE beng_case_conversion ADD FULLTEXT INDEX idx_beng_owned(title,body) WITH PARSER beng;
SELECT id,MATCH(title,body) AGAINST('alpha') > 0 AS alpha_hit FROM beng_case_conversion ORDER BY id;
SELECT id FROM beng_case_conversion WHERE MATCH(title,body) AGAINST('omega') ORDER BY id;
UPDATE beng_case_conversion SET body='replacement upsilon' WHERE id=1;
SELECT id FROM beng_case_conversion WHERE MATCH(title,body) AGAINST('omega') ORDER BY id;
DELETE FROM beng_case_conversion WHERE id=3;
SELECT id FROM beng_case_conversion WHERE MATCH(title,body) AGAINST('alpha') ORDER BY id;
DROP TABLE beng_case_conversion;

SELECT TOKENIZE(_utf8mb4'É é e E Ç ç c C' COLLATE utf8mb4_general_ci, 'beng', '[{"output":"all"}]') AS tokens;
SELECT TOKENIZE(_utf8mb4'E e é É C c ç Ç' COLLATE utf8mb4_general_ci, 'beng', '[{"output":"all"}]') AS tokens;

SELECT TOKENIZE('!!! ??? ___ --- ... +++', 'beng', '[{"output":"all"}]') AS tokens;
SELECT TOKENIZE('a 7 Z ! ? _ - alpha beta', 'beng', '[{"output":"all"}]') AS tokens;
SELECT TOKENIZE(CONCAT(REPEAT('!@#$%^&*()_+-=[]{}',64),' __ab__ --alpha-- z 9'), 'beng', '[{"output":"all"}]') AS tokens;

SELECT TOKENIZE(CONCAT(REPEAT('the with from for this that ',40),'apple banana apple'), 'beng', '[{"output":"all"}]') AS tokens;
SELECT TOKENIZE('the THE with WITH 苹果 apple APPLE banana', 'beng', '[{"output":"all"}]') AS tokens;

SELECT TOKENIZE(CONCAT(REPEAT('the with from for this that ',2),'数据库 apple banana apple'), 'ik') AS tokens;
SELECT TOKENIZE('the THE with WITH 苹果 apple APPLE banana', 'ik') AS tokens;

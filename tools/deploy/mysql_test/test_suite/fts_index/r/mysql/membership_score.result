drop database if exists fts_membership;
create database fts_membership;
use fts_membership;
create table docs(id int primary key, body text,
fulltext index ft(body) with parser beng);
insert into docs values
(1,'common apple apple'), (2,'common banana'),
(3,'common apple banana'), (4,'common cherry'),
(5,'common'), (6,''), (7,NULL), (8,'common banana apple cherry');
select id from docs where match(body) against('apple banana') order by id;
id
1
2
3
8
select count(*) from docs where match(body) against('apple banana');
count(*)
4
select count(*) from docs where match(body) against('common');
count(*)
6
select count(*) from docs where match(body) against('missingword');
count(*)
0
select count(*) from docs where match(body) against('');
count(*)
0
select count(*) from (select id from docs where match(body) against('apple banana') limit 2) x;
count(*)
2
select id, round(match(body) against('apple banana'),8) as score
from docs where match(body) against('apple banana') order by score desc,id;
id	score
3	1.26670990
8	1.19803286
1	0.77382667
2	0.67186978
select id, (match(body) against('apple banana') > 0) as matched
from docs where match(body) against('apple banana') order by id;
id	matched
1	1
2	1
3	1
8	1
select count(*) from docs where match(body) against('apple banana') >= 0;
count(*)
8
select count(*) from docs where match(body) against('apple banana') = 0;
count(*)
4
select count(*) from docs where match(body) against('apple banana') > 1;
count(*)
2
select sum(score > 0) from (select match(body) against('apple banana') as score from docs) x;
sum(score > 0)
4
select id from docs where match(body) against('+apple -banana' in boolean mode) order by id;
id
1
prepare q from 'select id from docs where match(body) against(''apple banana'') > ? order by id';
set @cutoff=0;
execute q using @cutoff;
id
1
2
3
8
set @cutoff=100;
execute q using @cutoff;
id
set @cutoff=0;
execute q using @cutoff;
id
1
2
3
8
deallocate prepare q;
prepare membership from 'select count(*) from docs where match(body) against(?)';
set @term='apple';
execute membership using @term;
count(*)
3
set @term='missingword';
execute membership using @term;
count(*)
0
set @term='banana';
execute membership using @term;
count(*)
3
set @term='';
execute membership using @term;
count(*)
0
set @term='apple';
execute membership using @term;
count(*)
3

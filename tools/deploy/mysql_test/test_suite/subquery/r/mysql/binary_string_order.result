SELECT STRCMP(CAST(X'6120' AS BINARY),CAST(X'61' AS BINARY)) AS trailing_space,STRCMP(CAST(X'6100' AS BINARY),CAST(X'61' AS BINARY)) AS trailing_zero,STRCMP(CAST(X'ff' AS BINARY),CAST(X'7f' AS BINARY)) AS high_byte;

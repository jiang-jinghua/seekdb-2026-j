SET NAMES utf8mb4;
SELECT TOKENIZE('a ab abc abcdef database oceanbase 123 123abc', 'ik', '[{"output":"all"}]') AS tokens;
tokens
{"tokens": [{"abcdef": 1}, {"ab": 1}, {"123": 1}, {"a": 1}, {"oceanbase": 1}, {"database": 1}, {"123abc": 1}, {"abc": 1}], "doc_len": 8}

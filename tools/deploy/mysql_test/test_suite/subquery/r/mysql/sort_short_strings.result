SET NAMES utf8mb4;
SELECT STRCMP('alpha','alpha') AS eq, STRCMP('alpha','ALPHA') AS ci, STRCMP('alpha','beta') AS neq;
eq	ci	neq
0	0	-1
SELECT STRCMP(CONVERT(X'610062' USING utf8mb4),CONVERT(X'610062' USING utf8mb4)) AS nul_equal;
nul_equal
0
SELECT STRCMP('','') AS empty_equal,STRCMP('alpha','alpha ') AS pad_equal;
empty_equal	pad_equal
0	0
SELECT STRCMP(REPEAT('a',32),REPEAT('a',32)) AS bound_equal,STRCMP(REPEAT('a',33),REPEAT('a',33)) AS long_equal;
bound_equal	long_equal
0	0
SELECT STRCMP(REPEAT('a',31),CONCAT(REPEAT('a',30),'b')) AS bound_different;
bound_different
-1
SELECT STRCMP(CONVERT(X'e695b0e68daee5ba93' USING utf8mb4),CONVERT(X'e695b0e68daee5ba93' USING utf8mb4)) AS unicode_equal;
unicode_equal
0
DROP TABLE IF EXISTS sort_short_strings;
